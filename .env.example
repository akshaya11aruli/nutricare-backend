# Database Configuration (MySQL 8)
# For local development:
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/nutricare_ai?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# For hosted database on Render / Railway / Aiven / PlanetScale:
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql-host.example.com:3306/nutricare_ai?useSSL=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=hosted_db_user
# SPRING_DATASOURCE_PASSWORD=hosted_db_password

# Port
PORT=8080

# JWT Authentication Secret (Must be 32+ characters)
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Allowed CORS Frontend Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://nutricare-ai.vercel.app
